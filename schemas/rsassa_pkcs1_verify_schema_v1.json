{
  "type": "object",
  "definitions": {
    "RsassaPkcs1TestGroup": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "RsassaPkcs1Verify"
          ]
        },
        "source": {
          "$ref": "common.json#/definitions/Source"
        },
        "publicKeyAsn": {
          "type": "string",
          "format": "Der",
          "description": "DER-encoded PKCS #1 RSAPublicKey (sequence of n and e)"
        },
        "publicKeyDer": {
          "type": "string",
          "format": "Der",
          "description": "DER-encoded SubjectPublicKeyInfo"
        },
        "publicKeyPem": {
          "type": "string",
          "format": "Pem",
          "description": "PEM-encoded SubjectPublicKeyInfo"
        },
        "publicKey": {
          "type": "object",
          "properties": {
            "modulus": {
              "type": "string",
              "format": "BigInt",
              "description": "The modulus of the key"
            },
            "publicExponent": {
              "type": "string",
              "format": "BigInt",
              "description": "The public exponent"
            }
          },
          "required": ["modulus", "publicExponent"]
        },
        "keyJwk": {
          "$ref": "json_web_crypto_common.json#/definitions/JsonWebKey"
        },
        "keySize": {
          "type": "integer",
          "description": "the size of the modulus in bits"
        },
        "sha": {
          "type": "string",
          "description": "the hash function used for the message"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "signatures_common.json#/definitions/SignatureTestVector"
          }
        }
      },
      "required": ["type", "source", "publicKeyAsn", "publicKeyDer", "publicKeyPem", "publicKey", "keySize", "sha", "tests"],
      "additionalProperties": false
    }
  },
  "properties": {
    "algorithm": {
      "type": "string",
      "description": "the primitive tested in the test file"
    },
    "generatorVersion": {
      "type": "string",
      "description": "DEPRECATED: prefer \"source\" property in test group",
      "deprecated": true
    },
    "header": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "additional documentation"
    },
    "notes": {
      "$ref": "common.json#/definitions/Notes"
    },
    "numberOfTests": {
      "type": "integer",
      "description": "the number of test vectors in this test"
    },
    "schema": {
      "enum": [
        "rsassa_pkcs1_verify_schema_v1.json"
      ]
    },
    "testGroups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RsassaPkcs1TestGroup"
      }
    }
  },
  "required": ["algorithm", "header", "notes", "numberOfTests", "schema", "testGroups"],
  "additionalProperties": false
}
