{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "FpeListTestGroup": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "FpeListTest"
          ]
        },
        "source": {
          "$ref": "common.json#/definitions/Source"
        },
        "keySize": {
          "type": "integer",
          "description": "The key size in bits"
        },
        "msgSize": {
          "type": "integer",
          "description": "The length of plaintexts and ciphertexts in digits"
        },
        "radix": {
          "type": "integer",
          "description": "The radix, i.e. the number of possible digit values"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FpeListTestVector"
          }
        }
      },
      "required": ["type", "source", "keySize", "msgSize", "radix", "tests"],
      "additionalProperties": false
    },
    "FpeListTestVector": {
      "type": "object",
      "properties": {
        "tcId": {
          "type": "integer",
          "description": "Identifier of the test case"
        },
        "comment": {
          "type": "string",
          "description": "A brief description of the test case"
        },
        "key": {
          "type": "string",
          "format": "HexBytes",
          "description": "The key"
        },
        "tweak": {
          "type": "string",
          "format": "HexBytes",
          "description": "The tweak"
        },
        "msg": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "The plaintext, a list of digits in the range 0..radix-1. Invalid test cases may contain digits outside this range."
        },
        "ct": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "The ciphertext, a list of digits in the range 0..radix-1"
        },
        "result": {
          "$ref": "common.json#/definitions/Result"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of flags"
        }
      },
      "required": ["tcId", "comment", "key", "tweak", "msg", "ct", "result", "flags"],
      "additionalProperties": false
    }
  },
  "properties": {
    "algorithm": {
      "enum": [
        "AES-FF1"
      ]
    },
    "generatorVersion": {
      "type": "string",
      "description": "DEPRECATED: prefer \"source\" property in test group",
      "deprecated": true
    },
    "header": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional documentation"
    },
    "notes": {
      "$ref": "common.json#/definitions/Notes"
    },
    "numberOfTests": {
      "type": "integer",
      "description": "The number of test vectors in this test"
    },
    "schema": {
      "enum": [
        "fpe_list_test_schema.json"
      ]
    },
    "testGroups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FpeListTestGroup"
      }
    }
  },
  "required": ["algorithm", "header", "notes", "numberOfTests", "schema", "testGroups"],
  "additionalProperties": false
}
