{
  "type": "object",
  "properties": {
    "algorithm": { "type": "string" },
    "schema": { "type": "string" },
    "numberOfTests": { "type": "integer" },
    "notes": { "type": "object" },
    "testGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "source": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" }
            },
            "required": ["name", "version"]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tcId": { "type": "integer" },
                "value": { "type": "string" }
              },
              "required": ["tcId", "value"]
            }
          }
        },
        "required": ["type", "source", "tests"]
      }
    }
  },
  "required": ["algorithm", "schema", "numberOfTests", "notes", "testGroups"]
}
