{
  "algorithm": "HPKE",
  "schema": "hpke_decrypt_test_schema.json",
  "numberOfTests": 20,
  "header": [
    "HPKE (RFC 9180) base-mode decryption (SetupBaseR then Open) with DHKEM(X25519, HKDF-SHA256). See doc/hpke.md."
  ],
  "notes": {
    "AppendedByteCiphertext": {
      "bugType": "AUTH_BYPASS",
      "description": "A trailing byte was appended to the AEAD ciphertext."
    },
    "EmptyAad": {
      "bugType": "EDGE_CASE",
      "description": "The AEAD associated data is empty."
    },
    "EmptyCiphertext": {
      "bugType": "AUTH_BYPASS",
      "description": "The AEAD ciphertext is empty (shorter than one tag)."
    },
    "EmptyInfo": {
      "bugType": "EDGE_CASE",
      "description": "The HPKE info string is empty."
    },
    "EmptyPlaintext": {
      "bugType": "EDGE_CASE",
      "description": "The sealed plaintext is empty."
    },
    "LongPlaintext": {
      "bugType": "EDGE_CASE",
      "description": "A 512-byte plaintext, exercising the AEAD across multiple blocks."
    },
    "MismatchedEncCt": {
      "bugType": "AUTH_BYPASS",
      "description": "enc and ct come from two different encapsulations to the same recipient, so the AEAD key derived from enc does not match the one that sealed ct; Open must fail."
    },
    "ModifiedCiphertext": {
      "bugType": "AUTH_BYPASS",
      "description": "A bit of the AEAD ciphertext body was flipped."
    },
    "ModifiedEnc": {
      "bugType": "AUTH_BYPASS",
      "description": "A bit of the KEM encapsulation enc (an X25519 ephemeral public key) was flipped, so the Diffie-Hellman shared secret and the AEAD key derived from it differ; Open must fail at the AEAD tag check."
    },
    "ModifiedTag": {
      "bugType": "AUTH_BYPASS",
      "description": "A bit of the AEAD authentication tag was flipped."
    },
    "Pseudorandom": {
      "bugType": "BASIC",
      "description": "A valid HPKE base-mode ciphertext with deterministic encapsulation from ikmE (the sender's ephemeral private key)."
    },
    "SmallOrderEnc": {
      "bugType": "CAN_OF_WORMS",
      "description": "enc is the all-zero X25519 public key, a small-order point. The Diffie-Hellman shared secret is all-zero, so the KEM MUST abort (RFC 9180 Section 5.1.1 requires DH to reject an all-zero output; RFC 7748 makes the check optional at the X25519 primitive layer). An implementation may surface this at SetupBaseR or carry the mismatched key through to a failed AEAD tag; either way Open must fail."
    },
    "TruncatedCiphertext": {
      "bugType": "AUTH_BYPASS",
      "description": "The AEAD ciphertext is truncated below the tag length."
    },
    "WrongAad": {
      "bugType": "AUTH_BYPASS",
      "description": "The aad differs from the one sealed under; accepting it would bypass AEAD authentication of the associated data."
    },
    "WrongInfo": {
      "bugType": "AUTH_BYPASS",
      "description": "The info differs from the one sealed under, so the key schedule derives a different key; accepting it would bypass the info binding (RFC 9180 Section 5.1)."
    },
    "WrongLengthEnc": {
      "bugType": "MODIFIED_PARAMETER",
      "description": "enc does not have the KEM's Nenc length (empty, short, or long) and must be rejected by SetupBaseR."
    },
    "WrongRecipientEnc": {
      "bugType": "CONFIDENTIALITY",
      "description": "enc and ct are a valid encapsulation and sealing for a different recipient key. The Diffie-Hellman shared secret under this skRm differs, so Open must fail."
    }
  },
