{
  "algorithm": "HPKE",
  "schema": "hpke_encap_test_schema.json",
  "numberOfTests": 6,
  "header": [
    "HPKE (RFC 9180) base-mode encapsulation-key validation (SetupBaseS) with DHKEM(X25519, HKDF-SHA256). See doc/hpke.md."
  ],
  "notes": {
    "LowOrderPublic": {
      "bugType": "DEFINED",
      "description": "The encapsulation key is a low-order point on the curve or its twist."
    },
    "NonCanonicalPublic": {
      "bugType": "DEFINED",
      "description": "The encapsulation key is in non-canonical form (its u coordinate is >= p; RFC 7748 Section 5 reduces it mod p)."
    },
    "Pseudorandom": {
      "bugType": "BASIC",
      "description": "A well-formed encapsulation key; SetupBaseS must succeed."
    },
    "SmallPublicKey": {
      "bugType": "DEFINED",
      "description": "The encapsulation key is the all-zero value; it is a small-order point and does not belong to a valid private key."
    },
    "WrongLengthPublicKey": {
      "bugType": "MODIFIED_PARAMETER",
      "description": "The encapsulation key is not 32 bytes (empty, short, or long) and must be rejected."
    },
    "ZeroSharedSecret": {
      "bugType": "DEFINED",
      "description": "The encapsulation key is a low-order point whose X25519 Diffie-Hellman output is all-zero. RFC 9180 Section 5.1.1 requires DH to abort on an all-zero shared secret, so SetupBaseS MUST fail. (Plain X25519, RFC 7748, leaves this check optional.)"
    }
  },
  "testGroups": [
    {
