{
  "algorithm": "HPKE",
  "schema": "hpke_encap_test_schema.json",
  "numberOfTests": 8,
  "header": [
    "HPKE (RFC 9180) base-mode encapsulation-key validation (SetupBaseS) with the ML-KEM-1024 KEM from draft-ietf-hpke-pq. See doc/hpke.md."
  ],
  "notes": {
    "ModulusOverflow": {
      "bugType": "CAN_OF_WORMS",
      "description": "The encapsulation key has a polynomial coefficient that overflows the field modulus and must fail the ML-KEM encapsulation-key check (FIPS 203 Section 7.2), surfacing as an HPKE EncapError. Lifted from the Wycheproof ML-KEM encapsulation vectors."
    },
    "Pseudorandom": {
      "bugType": "BASIC",
      "description": "A well-formed encapsulation key; SetupBaseS must succeed."
    },
    "PublicKeyAllZero": {
      "bugType": "EDGE_CASE",
      "description": "An all-zero encapsulation key. All coefficients are 0, which is below the ML-KEM modulus, so the encapsulation-key check (FIPS 203 Section 7.2) passes and SetupBaseS must succeed."
    },
    "WrongLengthPublicKey": {
      "bugType": "MODIFIED_PARAMETER",
      "description": "The encapsulation key does not have the KEM's Npk length (empty, short, long, or the length of a different ML-KEM parameter set) and must be rejected."
    }
  },
